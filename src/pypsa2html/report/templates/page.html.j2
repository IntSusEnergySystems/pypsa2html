{#
  pypsa2html page template.

  Everything the legacy pypsa.html hardcoded in JavaScript -- the country
  <option> list, the six-branch updateCountry() chain and the six
  byte-identical fileOptions arrays -- is generated here from the node set and
  the page manifest.  Adding a node is a config change, not three edits to a
  JS blob.

  A page belongs to ONE report: a scenario's, or the comparison.  There is no
  scenario switcher: a report built alone cannot know which sibling reports
  exist, and the one it had pointed at pages that were never built (D24).

  The table of contents is rendered into the DOM instead of being injected as
  a JavaScript string literal, which removes the quote-escaping landmine that
  forced every legacy TOC entry to use single-quoted href attributes.
#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{# A shared page (maps, sensitivity sweeps) is the same file for every
   region, so naming one in its heading would attribute its content to
   whichever node happened to be built first. #}
<title>{{ project.name }}{% if not page.shared %} &ndash; {{ node.label }}{% endif %} &ndash; {{ page.title }}</title>
{% if plotly_js %}{{ plotly_js }}{% endif %}
<style>
:root {
  --p2h-bg: #ffffff; --p2h-fg: #1a1a1a; --p2h-muted: #5c5c5c;
  --p2h-line: #e2e2e2; --p2h-accent: #007a5e; --p2h-panel: #f7f7f5;
}
@media (prefers-color-scheme: dark) {
  :root { --p2h-bg:#15171a; --p2h-fg:#e8e8e8; --p2h-muted:#a0a0a0;
          --p2h-line:#2e3238; --p2h-accent:#4fd1a5; --p2h-panel:#1c1f23; }
}
* { box-sizing: border-box; }
body { margin:0; background:var(--p2h-bg); color:var(--p2h-fg);
       font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
       line-height:1.55; }
a { color: var(--p2h-accent); }
nav.p2h-top { position:sticky; top:0; z-index:50; display:flex; flex-wrap:wrap;
  gap:1rem; align-items:center; padding:.6rem 1.2rem;
  background:var(--p2h-panel); border-bottom:1px solid var(--p2h-line); }
nav.p2h-top .brand { font-weight:600; }
nav.p2h-top .p2h-subtitle { color:var(--p2h-muted); margin-right:auto; }
nav.p2h-top a.p2h-link { font-size:.9rem; }
nav.p2h-top img.logo { height:34px; vertical-align:middle; margin-right:.6rem; }
nav.p2h-top label { font-size:.85rem; color:var(--p2h-muted); margin-right:.3rem; }
nav.p2h-top select { padding:.3rem .5rem; border:1px solid var(--p2h-line);
  border-radius:4px; background:var(--p2h-bg); color:var(--p2h-fg); font-size:.9rem; }
main { max-width:1500px; margin:0 auto; padding:1.5rem 1.2rem 4rem; }
.p2h-layout { display:grid; grid-template-columns:minmax(0,1fr); gap:1.5rem; }
@media (min-width: 1100px) { .p2h-layout { grid-template-columns:230px minmax(0,1fr); } }
aside.p2h-toc { align-self:start; position:sticky; top:4.2rem;
  background:var(--p2h-panel); border:1px solid var(--p2h-line);
  border-radius:6px; padding:.9rem 1rem; font-size:.9rem; }
aside.p2h-toc h2 { font-size:.8rem; text-transform:uppercase;
  letter-spacing:.06em; color:var(--p2h-muted); margin:.2rem 0 .6rem; }
aside.p2h-toc ul { list-style:none; margin:0; padding:0; }
aside.p2h-toc li { margin:.35rem 0; }
aside.p2h-toc ul.pages { border-top:1px solid var(--p2h-line);
  margin-top:.8rem; padding-top:.6rem; }
aside.p2h-toc a.current { font-weight:600; }
section.p2h-section { margin-bottom:3rem; scroll-margin-top:4.5rem; }
section.p2h-section h2 { font-size:1.35rem; margin:0 0 .4rem;
  padding-bottom:.3rem; border-bottom:2px solid var(--p2h-accent); }
.p2h-desc { color:var(--p2h-muted); margin:.4rem 0 1rem; }
.p2h-chart { width:100%; overflow-x:auto; }
.p2h-maps img { max-width:100%; height:auto; display:block; }
.p2h-map-tabs { display:flex; flex-wrap:wrap; gap:.4rem; margin:0 0 .8rem; }
.p2h-map-tab { padding:.35rem .75rem; border:1px solid var(--p2h-line);
  border-radius:4px; background:var(--p2h-bg); color:var(--p2h-fg);
  cursor:pointer; font-size:.9rem; }
.p2h-map-tab.active { background:var(--p2h-accent); color:#fff; border-color:var(--p2h-accent); }
.p2h-embed { width:100%; border:0; min-height:820px; }
footer.p2h-foot { max-width:1500px; margin:0 auto; padding:1rem 1.2rem 3rem;
  color:var(--p2h-muted); font-size:.8rem; text-align:right;
  border-top:1px solid var(--p2h-line); }
.p2h-table { border-collapse:collapse; margin:.6rem 0 .2rem; font-size:.85rem; width:100%; }
.p2h-table th, .p2h-table td { padding:.3rem .5rem; border-bottom:1px solid var(--p2h-line);
  text-align:left; vertical-align:top; }
.p2h-table th { background:var(--p2h-panel); font-weight:600; }
.p2h-table .num { text-align:right; white-space:nowrap; font-variant-numeric:tabular-nums; }
.p2h-table tr.p2h-total td { font-weight:600; border-top:2px solid var(--p2h-line); }
.p2h-table tr.p2h-subtotal td { font-weight:600; }
.p2h-table tr.p2h-muted-row td { color:var(--p2h-muted); font-style:italic; }
.p2h-note { color:var(--p2h-muted); font-size:.9rem; margin:.6rem 0; }
.p2h-unit { color:var(--p2h-muted); font-size:.8rem; margin:0 0 1rem; }
.p2h-chart h3 { font-size:1.05rem; margin:1.2rem 0 .2rem; }
.p2h-chart h4 { font-size:.95rem; margin:1rem 0 .2rem; }
.p2h-chart details { margin:1rem 0; }
.p2h-chart summary { cursor:pointer; }
.p2h-missing { padding:1rem; border:1px dashed var(--p2h-line);
  border-radius:6px; color:var(--p2h-muted); }
/* Key-figures tables (scenario report and comparison). */
.p2h-kf-controls { display:flex; flex-wrap:wrap; gap:1rem; align-items:center; margin:.4rem 0 .6rem; }
.p2h-kf-controls label { font-size:.85rem; color:var(--p2h-muted); margin-right:.3rem; }
.p2h-kf-controls select { padding:.25rem .45rem; border:1px solid var(--p2h-line);
  border-radius:4px; background:var(--p2h-bg); color:var(--p2h-fg); }
.p2h-table tr.p2h-group td { font-weight:600; background:var(--p2h-panel);
  text-transform:uppercase; font-size:.75rem; letter-spacing:.05em; color:var(--p2h-muted); }
.p2h-table td.p2h-indent { padding-left:1.6rem; color:var(--p2h-muted); }
.p2h-table th.p2h-ref, .p2h-table td.p2h-ref { background:rgba(0,122,94,.07); }
.p2h-table td.p2h-unit-col { color:var(--p2h-muted); white-space:nowrap; }
.p2h-better { color:#1a7f37; }
.p2h-worse { color:#c0392b; }
.p2h-banner { padding:.7rem 1rem; border-left:4px solid #d4a017; background:rgba(212,160,23,.1);
  border-radius:4px; margin:.6rem 0 1rem; }
.p2h-banner ul { margin:.3rem 0 0 1.2rem; padding:0; }
.p2h-status-ok { color:#1a7f37; }
.p2h-status-warn { color:#b7791f; }
.p2h-status-bad { color:#c0392b; }
</style>
</head>
<body>

<nav class="p2h-top">
  <span class="brand">
    {%- if project.logo %}<img class="logo" src="{{ project.logo }}" alt="">{% endif -%}
    {%- if project.website %}<a href="{{ project.website }}">{{ project.name }}</a>
    {%- else %}{{ project.name }}{% endif -%}
  </span>
  <span class="p2h-subtitle">{{ subtitle }}</span>
  {% for l in links %}
  <a class="p2h-link" href="{{ l.href }}">{{ l.label }}</a>
  {% endfor %}

  {% if nodes|length > 1 %}
  <span>
    <label for="p2h-node">Region</label>
    <select id="p2h-node" onchange="p2hGo('node', this.value)">
      {% for n in nodes %}
      <option value="{{ n.code }}" {% if n.code == node.code %}selected{% endif %}>{{ n.label }}</option>
      {% endfor %}
    </select>
  </span>
  {% endif %}

</nav>

<main>
<div class="p2h-layout">
  <aside class="p2h-toc">
    {% if page.sections %}
    <h2>On this page</h2>
    <ul>
      {% for s in sections %}
      <li><a href="#{{ s.id }}">{{ s.title }}</a></li>
      {% endfor %}
    </ul>
    {% endif %}
    <h2 style="margin-top:1rem">Pages</h2>
    <ul class="pages">
      {% for p in manifest %}
      <li><a href="{{ p.href }}" {% if p.id == page.id %}class="current"{% endif %}>{{ p.title }}</a></li>
      {% endfor %}
    </ul>
  </aside>

  <div>
    <h1 style="margin-top:0">{% if not page.shared %}{{ node.label }} &mdash; {% endif %}{{ page.title }}</h1>
    {% if scenario_note %}<p class="p2h-desc">{{ scenario_note }}</p>{% endif %}
    {{ main_content }}
  </div>
</div>
</main>

<footer class="p2h-foot">
  Generated by pypsa2html {{ version }} on {{ generated_at }}
  &middot; {{ footer }}
</footer>

<script>
// The URL contract is "<node>_<page>_<tag>.html" (shared pages drop the node
// prefix), where <tag> is the scenario name or the comparison's name.  The
// region selector rebuilds the file name, so no per-node JS branch is needed.
var P2H = {
  node: {{ node.code | tojson }},
  tag: {{ file_tag | tojson }},
  page: {{ page.id | tojson }},
  shared: {{ page.shared | tojson }}
};
function p2hGo(what, value) {
  var node = what === 'node' ? value : P2H.node;
  window.location.href = P2H.shared ? (P2H.page + '_' + P2H.tag + '.html')
                                    : (node + '_' + P2H.page + '_' + P2H.tag + '.html');
}
</script>
</body>
</html>
